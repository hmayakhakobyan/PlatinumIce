# Platinum Ice asset sync manifest - machine-local (attachment IDs, URLs,
# and file hashes are specific to this WordPress install and should never
# be committed). The sync script itself (dev-tools/sync-assets.ps1) is
# tracked; this generated data file is not.
dev-tools/asset-sync.local.json

# Platinum Ice asset sync local config - machine-specific absolute paths
# and site URL (see dev-tools/asset-sync.local.psd1.example, which IS
# tracked, for the template).
dev-tools/asset-sync.local.psd1

# Third-party CLI-agent skill packs installed via `npx skills add` (e.g.
# Higgsfield). These are machine-tool-managed, not theme source - the
# installer itself flags some of them High/Critical Risk in its own
# automated scan, so they're deliberately never committed to this repo.
.agents/
.claude/
skills-lock.json
